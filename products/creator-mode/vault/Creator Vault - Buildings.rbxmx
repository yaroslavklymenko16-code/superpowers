</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000287"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- DOOR: press E to open and close.
local door = script.Parent
local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Open"
prompt.ObjectText = "Door"
prompt.Parent = door
local open = false
prompt.Triggered:Connect(function()
	open = not open
	door.Transparency = open and 0.75 or 0
	door.CanCollide = not open
	prompt.ActionText = open and "Close" or "Open"
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000289"><Properties><string name="Name">Roof</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>238.4</X><Y>6.6995</Y><Z>0</Z><R00>0.9063</R00><R01>-0.4226</R01><R02>0</R02><R10>0.4226</R10><R11>0.9063</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>3.9101</X><Y>0.6</Y><Z>6</Z></Vector3><Color3uint8 name="Color3uint8">4283784035</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000290"><Properties><string name="Name">Roof</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>241.4</X><Y>6.6995</Y><Z>0</Z><R00>0.9063</R00><R01>0.4226</R01><R02>0</R02><R10>-0.4226</R10><R11>0.9063</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>3.9101</X><Y>0.6</Y><Z>6</Z></Vector3><Color3uint8 name="Color3uint8">4283784035</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item></Item></roblox>