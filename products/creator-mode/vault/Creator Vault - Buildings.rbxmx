local door = script.Parent
local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Open"
prompt.ObjectText = "Door"
prompt.Parent = door
local open = false
prompt.Triggered:Connect(function()
	open = not open
	door.Transparency = open and 0.75 or 0
	door.CanCollide = not open
	prompt.ActionText = open and "Close" or "Open"
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000161"><Properties><string name="Name">Window</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>4.4</X><Y>5</Y><Z>-4.7</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>2.5</X><Y>2.5</Y><Z>0.7</Z></Vector3><Color3uint8 name="Color3uint8">4289190143</Color3uint8><token name="Material">1568</token><bool name="CanCollide">true</bool><float name="Transparency">0.4</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000162"><Properties><string name="Name">Window</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>13.6</X><Y>5</Y><Z>-4.7</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>2.5</X><Y>2.5</Y><Z>0.7</Z></Vector3><Color3uint8 name="Color3uint8">4289190143</Color3uint8><token name="Material">1568</token><bool name="CanCollide">true</bool><float name="Transparency">0.4</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000163"><Properties><string name="Name">Chimney</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>13</X><Y>11</Y><Z>2</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.6</X><Y>4</Y><Z>1.6</Z></Vector3><Color3uint8 name="Color3uint8">4288563770</Color3uint8><token name="Material">848</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item