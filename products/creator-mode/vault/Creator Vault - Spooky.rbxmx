0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>10</X><Y>0.3</Y><Z>0.3</Z></Vector3><Color3uint8 name="Color3uint8">4280693304</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item><Item class="Model" referent="RBX000644"><Properties><string name="Name">Zombie Spawner</string></Properties><Item class="Part" referent="RBX000643"><Properties><string name="Name">Grave Hole</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>86.1</X><Y>0.2</Y><Z>0</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>6</Y><Z>6</Z></Vector3><Color3uint8 name="Color3uint8">4281559326</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties><Item class="PointLight" referent="RBX000641"><Properties><string name="Name">Glow</string><Color3 name="Color"><R>0.4627</R><G>1</G><B>0.0118</B></Color3><float name="Brightness">2</float><float name="Range">16</float></Properties></Item><Item class="Script" referent="RBX000642"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- ZOMBIE SPAWNER: makes a zombie every few seconds that chases the nearest player.
local Players = game:GetService("Players")
local spawner = script.Parent
local MAX_ZOMBIES = 5
local EVERY = 6
local alive = 0

local function nearest(position)
	local best, bestDist = nil, 120
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			local d = (root.Position - position).Magnitude
			if d < bestDist then
				best, bestDist = char, d
			end
		end
	end
	return best, bestDist
end

local function spawnZombie()
	local desc = Instance.new("HumanoidDescription")
	local green = Color3.fromRGB(110, 170, 90)
	desc.HeadColor = green
	desc.LeftArmColor = green
	desc.RightArmColor = green
	desc.TorsoColor = Color3.fromRGB(70, 80, 110)
	desc.LeftLegColor = Color3.fromRGB(60, 50, 40)
	desc.RightLegColor = Color3.fromRGB(60, 50, 40)
	local zombie = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	zombie.Name = "Zombie"
	zombie:PivotTo(spawner.CFrame + Vector3.new(0, 5, 0))
	zombie.Parent = workspace
	local hum = zombie:FindFirstChildOfClass("Humanoid")
	local root = zombie:FindFirstChild("HumanoidRootPart")
	hum.WalkSpeed = 9
	root:SetNetworkOwner(nil)
	alive += 1
	hum.Died:Connect(function()
		alive -= 1
		game:GetService("Debris"):AddItem(zombie, 2)
	end)
	local lastHit = 0
	while zombie.Parent and hum.Health > 0 do
		local target, dist = nearest(root.Position)
		if target then
			hum:MoveTo(target.HumanoidRootPart.Position)
			if dist < 4.5 and os.clock() - lastHit > 1 then
				lastHit = os.clock()
				target:FindFirstChildOfClass("Humanoid"):TakeDamage(10)
			end
		end
		task.wait(0.25)
	end
end

while true do
	if alive < MAX_ZOMBIES then
		task.spawn(spawnZombie)
	end
	task.wait(EVERY)
end
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>