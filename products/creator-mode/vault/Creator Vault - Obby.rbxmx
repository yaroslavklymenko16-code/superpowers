ce">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000434"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- MOVING PLATFORM: slides back and forth and carries players with it.
local RunService = game:GetService("RunService")
local platform = script.Parent
local DISTANCE = 10 -- studs each way
local SPEED = 1 -- bigger = faster
local start = platform.CFrame
local t0 = os.clock()
RunService.Heartbeat:Connect(function()
	local t = (os.clock() - t0) * SPEED
	platform.CFrame = start * CFrame.new(math.sin(t) * DISTANCE, 0, 0)
	platform.AssemblyLinearVelocity = start.RightVector * math.cos(t) * DISTANCE * SPEED
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000439"><Properties><string name="Name">Elevator</string></Properties><Item class="Part" referent="RBX000438"><Properties><string name="Name">Elevator</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>138</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>8</X><Y>1</Y><Z>8</Z></Vector3><Color3uint8 name="Color3uint8">4286336511</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000437"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- MOVING PLATFORM: slides back and forth and carries players with it.
local RunService = game:GetService("RunService")
local platform = script.Parent
local DISTANCE = 10 -- studs each way
local SPEED = 1 -- bigger = faster
local start = platform.CFrame
local t0 = os.clock()
RunService.Heartbeat:Connect(function()
	local t = (os.clock() - t0) * SPEED
	platform.CFrame = start * CFrame.new(0, math.sin(t) * DISTANCE, 0)
	platform.AssemblyLinearVelocity = start.UpVector * math.cos(t) * DISTANCE * SPEED
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000443"><Properties><string name="Name">Spinner</string></Properties><Item class="Part" referent="RBX000440"><Properties><string name="Name">Pillar</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>157</X><Y>1.5</Y><Z>0</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>3</X><Y>1.6</Y><Z>1.6</Z></Vector3><Color3uint8 name="Color3uint8">4281545523</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item><Item class="Part" referent="RBX000442"><Properties><string name="Name">Laser</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>157</X><Y>3.4</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>18</X><Y>0.8</Y><Z>0.8</Z></Vector3><Color3uint8 name="Color3uint8">4294907716</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000441"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- SPINNER: spins forever and knocks out anyone it hits.
local RunService = game:GetService("RunService")
local bar = script.Parent
local SPEED = 2 -- spins per... well, try it!
RunService.Heartbeat:Connect(function(dt)
	bar.CFrame = bar.CFrame * CFrame.Angles(0, SPEED * dt, 0)
end)
bar.Touched:Connect(function(hit)
	local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = 0
	end
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000446"><Properties><string name="Name">Vanishing Block</string></Properties><Item class="Part" referent="RBX000445"><Properties><string name="Name">Vanishing Block</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>175</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>6</X><Y>1</Y><Z>6</Z></Vector3><Color3uint8 name="Color3uint8">4286635754</Color3uint8><token name="Material">1568</token><bool name="CanCollide">true</bool><float name="Transparency">0.2</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000444"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- VANISHING BLOCK: fades away when you stand on it, then comes back.
local part = script.Parent
local busy = false
part.Touched:Connect(function(hit)
	if busy or not (hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")) then
		return
	end
	busy = true
	local start = part.Transparency
	for i = 1, 6 do
		part.Transparency = start + (1 - start) * i / 6
		task.wait(0.12)
	end
	part.CanCollide = false
	task.wait(2.5)
	part.CanCollide = true
	part.Transparency = start
	busy = false
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000449"><Properties><string name="Name">Jump Pad</string></Properties><Item class="Part" referent="RBX000448"><Properties><string name="Name">Jump Pad</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>187</X><Y>0.3</Y><Z>0</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.6</X><Y>6</Y><Z>6</Z></Vector3><Color3uint8 name="Color3uint8">4294961664</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties><Item class="Script" referent="RBX000447"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- JUMP PAD: launches you into the sky.
local POWER = 110
local pad = script.Parent
local cooldown = {}
pad.Touched:Connect(function(hit)
	local character = hit.Parent
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and character:FindFirstChildOfClass("Humanoid") and not cooldown[character] then
		cooldown[character] = true
		local push = Instance.new("BodyVelocity")
		push.MaxForce = Vector3.new(0, math.huge, 0)
		push.Velocity = Vector3.new(0, POWER, 0)
		push.Parent = root
		game:GetService("Debris"):AddItem(push, 0.25)
		task.wait(1)
		cooldown[character] = nil
	end
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000454"><Properties><string name="Name">Speed Pad</string></Properties><Item class="Part" referent="RBX000451"><Properties><string name="Name">Speed Pad</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>199</X><Y>0.2</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>6</X><Y>0.4</Y><Z>6</Z></Vector3><Color3uint8 name="Color3uint8">4278248959</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000450"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- SPEED PAD: super speed for a few seconds.
local BOOST_SPEED = 50
local SECONDS = 4
local pad = script.Parent
local boosted = {}
pad.Touched:Connect(function(hit)
	local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid and not boosted[humanoid] then
		boosted[humanoid] = true
		humanoid.WalkSpeed = BOOST_SPEED
		task.wait(SECONDS)
		humanoid.WalkSpeed = 16
		boosted[humanoid] = nil
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000452"><Properties><string name="Name">Arrow</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>197.5</X><Y>0.45</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>0.1</Y><Z>2.4</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000453"><Properties><string name="Name">Arrow</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>200.5</X><Y>0.45</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>0.1</Y><Z>2.4</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item><Item class="Model" referent="RBX000457"><Properties><string name="Name">Conveyor</string></Properties><Item class="Part" referent="RBX000456"><Properties><string name="Name">Conveyor</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>211</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>6</X><Y>1</Y><Z>20</Z></Vector3><Color3uint8 name="Color3uint8">4280361249</Color3uint8><token name="Material">1056</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000455"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- CONVEYOR: pushes anything on top of it in the direction it faces.
