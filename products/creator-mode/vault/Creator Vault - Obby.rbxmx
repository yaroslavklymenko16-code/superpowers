e">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="PointLight" referent="RBX000461"><Properties><string name="Name">Glow</string><Color3 name="Color"><R>1</R><G>0.8784</G><B>0.4</B></Color3><float name="Brightness">2</float><float name="Range">16</float></Properties></Item><Item class="Sparkles" referent="RBX000462"><Properties><string name="Name">Sparkles</string></Properties></Item><Item class="Script" referent="RBX000463"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[local function stat(player, name)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local value = stats:FindFirstChild(name)
	if not value then
		value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	return value
end

-- WIN PAD: +1 Win, then back to the start.
local Players = game:GetService("Players")
local pad = script.Parent
local done = {}
pad.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if player and not done[player] then
		done[player] = true
		stat(player, "Wins").Value += 1
		local saved = player:FindFirstChild("SavedCheckpoint")
		if saved then
			saved.Value = nil
		end
		task.wait(2)
		player:LoadCharacter()
		done[player] = nil
	end
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000478"><Properties><string name="Name">Laser Gate</string></Properties><Item class="Part" referent="RBX000466"><Properties><string name="Name">Post</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>250.5</X><Y>4</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>8</Y><Z>1</Z></Vector3><Color3uint8 name="Color3uint8">4281812815</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000467"><Properties><string name="Name">Post</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>260.5</X><Y>4</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>8</Y><Z>1</Z></Vector3><Color3uint8 name="Color3uint8">4281812815</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000469"><Properties><string name="Name">Laser</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>255.5</X><Y>1</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>9</X><Y>0.4</Y><Z>0.4</Z></Vector3><Color3uint8 name="Color3uint8">4294907716</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000468"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- LASER GATE: blinks on and off. Time your run!
local laser = script.Parent
local ON_TIME = 1.5
local OFF_TIME = 1.5
local on = true
laser.Touched:Connect(function(hit)
	local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid and on then
		humanoid.Health = 0
	end
end)
while true do
	on = true
	laser.Transparency = 0.1
	task.wait(ON_TIME)
	on = false
	laser.Transparency = 0.9
	task.wait(OFF_TIME)
end
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000471"><Properties><string name="Name">Laser</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>255.5</X><Y>2.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>9</X><Y>0.4</Y><Z>0.4</Z></Vector3><Color3uint8 name="Color3uint8">4294907716</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000470"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- LASER GATE: blinks on and off. Time your run!
