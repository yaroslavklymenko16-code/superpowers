local DAMAGE = 20
local part = script.Parent
local cooldown = {}
part.Touched:Connect(function(hit)
	local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid and not cooldown[humanoid] then
		cooldown[humanoid] = true
		humanoid:TakeDamage(DAMAGE)
		task.wait(1)
		cooldown[humanoid] = nil
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000409"><Properties><string name="Name">Spike</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>61</X><Y>1.2</Y><Z>-2</Z><R00>0.7071</R00><R01>0</R01><R02>0.7071</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.7071</R20><R21>0</R21><R22>0.7071</R22></CoordinateFrame><Vector3 name="size"><X>0.6</X><Y>1.6</Y><Z>0.6</Z></Vector3><Color3uint8 name="Color3uint8">4291811548</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000410"><Properties><string name="Name">Spike</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>63</X><Y>1.2</Y><Z>-2</Z><R00>0.7071</R00><R01>0</R01><R02>0.7071</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.7071</R20><R21>0</R21><R22>0.7071</R22></CoordinateFrame><Vector3 name="size"><X>0.6</X><Y>1.6</Y><Z>0.6</Z></Vector3><Color3uint8 name="Color3uint8">4291811548</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000411"><Properties><string name="Name">Spike</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>65</X><Y>1.2</Y><Z>-2</Z><R00>0.7071</R00><R01>0</R01><R02>0.7071</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.7071</R20><R21>0</R21><R22>0.7071</R22></CoordinateFrame><Vector3 name="size"><X>0.6</X><Y>1.6</Y><Z>0.6</Z></Vector3><Color3uint8 name="Color3uint8">4291811548</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</tok