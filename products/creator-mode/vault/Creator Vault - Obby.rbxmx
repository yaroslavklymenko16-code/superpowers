oken><token name="shape">1</token></Properties></Item></Item><Item class="Model" referent="RBX000423"><Properties><string name="Name">Checkpoint 1</string></Properties><Item class="Part" referent="RBX000420"><Properties><string name="Name">Checkpoint 1</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>76</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>8</X><Y>1</Y><Z>8</Z></Vector3><Color3uint8 name="Color3uint8">4282449792</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000419"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- CHECKPOINT: rename it "Checkpoint 2", "Checkpoint 3"... for each stage.
-- When you fall, you come back to the highest checkpoint you touched.
local Players = game:GetService("Players")
local cp = script.Parent
local number = tonumber(string.match(cp.Name, "%d+")) or 1

local function hook(player)
	if player:GetAttribute("CheckpointHooked") then
		return
	end
	player:SetAttribute("CheckpointHooked", true)
	player.CharacterAdded:Connect(function(character)
		local saved = player:FindFirstChild("SavedCheckpoint")
		local root = character:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.1)
		if saved and saved.Value and root then
			character:PivotTo(saved.Value.CFrame + Vector3.new(0, 4, 0))
		end
	end)
end

cp.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player then
		return
	end
	hook(player)
	local saved = player:FindFirstChild("SavedCheckpoint")
	if not saved then
		saved = Instance.new("ObjectValue")
		saved.Name = "SavedCheckpoint"
		saved.Parent = player
	end
	local current = 0
	if saved.Value then
		current = tonumber(string.match(saved.Value.Name, "%d+")) or 1
	end
	if number >= current and saved.Value ~= cp then
		saved.Value = cp
		local stats = player:FindFirstChild("leaderstats")
		local stage = stats and stats:FindFirstChild("Stage")
		if stage then
			stage.Value = number
		end
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000421"><Properties><string name="Name">Pole</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>79</X><Y>4</Y><Z>3</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>6</X><Y>0.3</Y><Z>0.3</Z></Vector3><Color3uint8 name="Color3uint8">4293848814</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item><Item class="Part" referent="RBX000422"><Properties><string name="Name">Flag</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>79</X><Y>6</Y><Z>1.5</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.1</X><Y>2</Y><Z>3</Z></Vector3><Color3uint8 name="Color3uint8">4282449792</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item><Item class="Model" referent="RBX000428"><Properties><string name="Name">Checkpoint 2</string></Properties><Item class="Part" referent="RBX000425"><Properties><string name="Name">Checkpoint 2</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>92</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>8</X><Y>1</Y><Z>8</Z></Vector3><Color3uint8 name="Color3uint8">4282449792</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</to