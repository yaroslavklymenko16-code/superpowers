<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX000735"><Properties><string name="Name">Creator Vault - Game Systems</string></Properties><Item class="Model" referent="RBX000723"><Properties><string name="Name">Talking NPC</string></Properties><Item class="Part" referent="RBX000722"><Properties><string name="Name">NPC Stand</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>2</X><Y>0.2</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>4</X><Y>0.4</Y><Z>4</Z></Vector3><Color3uint8 name="Color3uint8">4291811548</Color3uint8><token name="Material">784</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000721"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- TALKING NPC: press E to talk. Change the LINES to write your own story!
local Players = game:GetService("Players")
local LINES = {
	"Hi there, traveler!",
	"They say there's treasure at the top of the tower...",
	"Watch out for the lava. Trust me.",
	"Good luck, hero!",
}
local NAME = "Guide"
local stand = script.Parent
local desc = Instance.new("HumanoidDescription")
desc.HeadColor = Color3.fromRGB(255, 205, 150)
desc.TorsoColor = Color3.fromRGB(60, 120, 255)
desc.LeftArmColor = Color3.fromRGB(255, 205, 150)
desc.RightArmColor = Color3.fromRGB(255, 205, 150)
desc.LeftLegColor = Color3.fromRGB(40, 40, 60)
desc.RightLegColor = Color3.fromRGB(40, 40, 60)
local npc = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
npc.Name = NAME
npc:PivotTo(stand.CFrame + Vector3.new(0, 4, 0))
npc.Parent = stand.Parent
npc.HumanoidRootPart.Anchored = true

local head = npc:WaitForChild("Head")
local bubble = Instance.new("BillboardGui")
bubble.Size = UDim2.new(0, 260, 0, 70)
bubble.StudsOffset = Vector3.new(0, 3, 0)
bubble.Enabled = false
bubble.Parent = head
local text = Instance.new("TextLabel")
text.Size = UDim2.new(1, 0, 1, 0)
text.BackgroundColor3 = Color3.new(1, 1, 1)
text.TextColor3 = Color3.new(0, 0, 0)
text.TextScaled = true
text.Font = Enum.Font.FredokaOne
text.Parent = bubble

local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Talk"
prompt.ObjectText = NAME
prompt.Parent = head
local line = 0
prompt.Triggered:Connect(function()
	line = line % #LINES + 1
	text.Text = LINES[line]
	bubble.Enabled = true
	task.delay(4, function()
		if text.Text == LINES[line] then
			bubble.Enabled = false
		end
	end)
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000731"><Properties><string name="Name">Mini Tycoon Kit</string></Properties><Item class="Part" referent="RBX000724"><Properties><string name="Name">ClaimPad</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>12.5</X><Y>0.5</Y><Z>-6</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>5</X><Y>1</Y><Z>5</Z></Vector3><Color3uint8 name="Color3uint8">4282449792</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000725"><Properties><string name="Name">Conveyor</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>21.5</X><Y>1.5</Y><Z>0</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><Vector3 name="size"><X>4</X><Y>1</Y><Z>20</Z></Vector3><Color3uint8 name="Color3uint8">4280361249</Color3uint8><token name="Material">1056</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000726"><Properties><string name="Name">Rail</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>23.7</X><Y>2.6</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>1.4</Y><Z>20</Z></Vector3><Color3uint8 name="Color3uint8">4294955583</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000727"><Properties><string name="Name">Rail</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>19.3</X><Y>2.6</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>1.4</Y><Z>20</Z></Vector3><Color3uint8 name="Color3uint8">4294955583</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000728"><Properties><string name="Name">Dropper</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>21.5</X><Y>8</Y><Z>-8</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>3</X><Y>3</Y><Z>3</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000729"><Properties><string name="Name">Collector</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>21.5</X><Y>2.5</Y><Z>11.5</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>5</X><Y>3</Y><Z>3</Z></Vector3><Color3uint8 name="Color3uint8">4282449792</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Script" referent="RBX000730"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[local function stat(player, name)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local value = stats:FindFirstChild(name)
	if not value then
		value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	return value
end

-- MINI TYCOON KIT: claim it, then the dropper makes cash for you.
-- Copy "Dropper" parts to add more. Blocks go: Dropper -> Conveyor -> Collector.
local Players = game:GetService("Players")
local kit = script.Parent
local claim = kit:WaitForChild("ClaimPad")
local collector = kit:WaitForChild("Collector")
local conveyor = kit:WaitForChild("Conveyor")
local owner = nil
conveyor.AssemblyLinearVelocity = conveyor.CFrame.LookVector * 10

claim.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if player and not owner then
		owner = player
		stat(player, "Cash")
		claim.Color = Color3.fromRGB(255, 200, 40)
	end
end)

collector.Touched:Connect(function(hit)
	local worth = hit:GetAttribute("Worth")
	if worth then
		hit:SetAttribute("Worth", nil)
		hit:Destroy()
		if owner and owner.Parent then
			stat(owner, "Cash").Value += worth
		end
	end
end)

local function runDropper(dropper)
	task.spawn(function()
		while dropper.Parent do
			if owner then
				local drop = Instance.new("Part")
				drop.Size = Vector3.new(1, 1, 1)
				drop.Color = dropper.Color
				drop.Material = Enum.Material.Neon
				drop.Position = dropper.Position - Vector3.new(0, dropper.Size.Y / 2 + 1, 0)
				drop:SetAttribute("Worth", 1)
				drop.Parent = kit
				drop:SetNetworkOwner(nil)
				game:GetService("Debris"):AddItem(drop, 20)
			end
			task.wait(2)
		end
	end)
end

for _, child in ipairs(kit:GetChildren()) do
	if child.Name == "Dropper" then
		runDropper(child)
	end
end
kit.ChildAdded:Connect(function(child)
	if child.Name == "Dropper" then
		runDropper(child)
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Model" referent="RBX000734"><Properties><string name="Name">Speed Shop Pad</string></Properties><Item class="Part" referent="RBX000733"><Properties><string name="Name">Shop Pad</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>40.5</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>6</X><Y>1</Y><Z>6</Z></Vector3><Color3uint8 name="Color3uint8">4294918273</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000732"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[local function stat(player, name)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local value = stats:FindFirstChild(name)
	if not value then
		value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	return value
end

-- SHOP PAD: spend Coins to get faster. Change PRICE and SPEED!
local Players = game:GetService("Players")
local PRICE = 20
local SPEED = 28
local pad = script.Parent
local gui = Instance.new("BillboardGui")
gui.Size = UDim2.new(0, 200, 0, 50)
gui.StudsOffset = Vector3.new(0, 3, 0)
gui.AlwaysOnTop = true
gui.Parent = pad
local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.TextScaled = true
label.Font = Enum.Font.FredokaOne
label.TextColor3 = Color3.new(1, 1, 1)
label.TextStrokeTransparency = 0
label.Text = "Speed Upgrade: " .. PRICE .. " coins"
label.Parent = gui
local owned = {}
pad.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player or owned[player] then
		return
	end
	local coins = stat(player, "Coins")
	if coins.Value >= PRICE then
		owned[player] = true
		coins.Value -= PRICE
		local humanoid = hit.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = SPEED
		end
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid").WalkSpeed = SPEED
		end)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>