tor3 name="size"><X>0.4</X><Y>0.4</Y><Z>0.4</Z></Vector3><Color3uint8 name="Color3uint8">4279308561</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">0</token></Properties></Item><Item class="Part" referent="RBX000649"><Properties><string name="Name">Ear</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0.5</X><Y>3.2</Y><Z>0</Z><R00>0.9397</R00><R01>-0.342</R01><R02>0</R02><R10>0.342</R10><R11>0.9397</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.5</X><Y>0.7</Y><Z>0.2</Z></Vector3><Color3uint8 name="Color3uint8">4294948685</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000650"><Properties><string name="Name">Ear</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>1.7</X><Y>3.2</Y><Z>0</Z><R00>0.9397</R00><R01>0.342</R01><R02>0</R02><R10>-0.342</R10><R11>0.9397</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.5</X><Y>0.7</Y><Z>0.2</Z></Vector3><Color3uint8 name="Color3uint8">4294948685</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Script" referent="RBX000651"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- PET: touch it and it follows you forever (until you leave).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local model = script.Parent
local body = model:WaitForChild("Body")
local owner = nil
body.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if player and not owner then
		owner = player
	end
end)
RunService.Heartbeat:Connect(function()
	local root = owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
	if root then
		local bob = math.sin(os.clock() * 3) * 0.5
		local goal = root.CFrame * CFrame.new(3, 1 + bob, 4)
		body.CFrame = body.CFrame:Lerp(goal, 0.12)
	end
end)
Players.PlayerRemoving:Connect(function(player)
	if player == owner then
		owner = nil
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Model" referent="RBX000660"><Properties><string name="Name">Bunny</string></Properties><Item class="Part" referent="RBX000653"><Properties><string name="Name">Body</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>9.3</X><Y>2</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>2.2</X><Y>2.2</Y><Z>2.2</Z></Vector3><Color3uint8 name="Color3uint8">4294309365</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">0</token></Properties></Item><Item class="Part" referent="RBX000654"><Properties><string name="Name">Eye</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>8.85</X><Y>2.3</Y><Z>-1</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>0.4</Y><Z>0.4</Z></Vector3><Color3uint8 name="Color3uint8">4279308561</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">0</token></Properties></Item><Item class="Part" referent="RBX000655"><Properties><string name="Name">Eye</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>9.75</X><Y>2.3</Y><Z>-1</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>0.4</Y><Z>0.4</Z></Vector3><Color3uint8 name="Color3uint8">4279308561</Color3uint8><token name="Material">272</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><to