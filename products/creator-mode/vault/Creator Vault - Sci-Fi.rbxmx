local model = script.Parent
local a = model:WaitForChild("PortalA")
local b = model:WaitForChild("PortalB")
local cooldown = {}
local function link(from, to)
	from.Touched:Connect(function(hit)
		local character = hit.Parent
		if character and character:FindFirstChildOfClass("Humanoid") and not cooldown[character] then
			cooldown[character] = true
			character:PivotTo(to.CFrame * CFrame.new(0, 0, -6))
			task.wait(1.5)
			cooldown[character] = nil
		end
	end)
end
link(a, b)
link(b, a)
]]></ProtectedString></Properties></Item></Item><Item class="Model" referent="RBX000534"><Properties><string name="Name">Blue Crystal</string></Properties><Item class="Part" referent="RBX000531"><Properties><string name="Name">Crystal</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>41</X><Y>3</Y><Z>0</Z><R00>0.7071</R00><R01>0</R01><R02>0.7071</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.7071</R20><R21>0</R21><R22>0.7071</R22></CoordinateFrame><Vector3 name="size"><X>1.6</X><Y>6</Y><Z>1.6</Z></Vector3><Color3uint8 name="Color3uint8">4282434815</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="PointLight" referent="RBX000530"><Properties><string name="Name">Glow</string><Color3 name="Color"><R>0.251</R><G>0.7686</G><B>1</B></Color3><float name="Brightness">2</float><float name="Range">16</float></Properties></Item></Item><Item class="Part" referent="RBX000532"><Properties><string name="Name">Crystal</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>42.3</X><Y>1.8</Y><Z>0.4</Z><R00>0.883</R00><R01>0.3214</R01><R02>0.342</R02><R10>-0.342</R10><R11>0.9397</R11><R12>0</R12><R20>-0.3214</R20><R21>-0.117</R21><R22>0.9397</R22></CoordinateFrame><Vector3 name="size"><X>1.1</X><Y>4</Y><Z>1.1</Z></Vector3><Color3uint8 name="Color3uint8">4282434815</Color3uint8><token name="Material">1568</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000533"><Properties><string name="Name">Crystal</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>39.8</X><Y>1.5</Y><Z>-0.3</Z><R00>0.9063</R00><R01>-0.4226</R01><R02>0</R02><R10>0.4082</R10><R11>0