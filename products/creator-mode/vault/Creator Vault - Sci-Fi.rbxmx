local POWER = 110
local pad = script.Parent
local cooldown = {}
pad.Touched:Connect(function(hit)
	local character = hit.Parent
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and character:FindFirstChildOfClass("Humanoid") and not cooldown[character] then
		cooldown[character] = true
		local push = Instance.new("BodyVelocity")
		push.MaxForce = Vector3.new(0, math.huge, 0)
		push.Velocity = Vector3.new(0, POWER, 0)
		push.Parent = root
		game:GetService("Debris"):AddItem(push, 0.25)
		task.wait(1)
		cooldown[character] = nil
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000572"><Properties><string name="Name">Ring</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>127.8</X><Y>0.1</Y><Z>0</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>7</Y><Z>7</Z></Vector3><Color3uint8 name="Color3uint8">4280693304</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item></Item><Item class="Model" referent="RBX000581"><Properties><string name="Name">Control Panel</string></Properties><Item class="Part" referent="RBX000574"><Properties><string name="Name">Desk</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>140.3</X><Y>1.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>6</X><Y>3</Y><Z>2</Z></Vector3><Color3uint8 name="Color3uint8">4281812815</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000575"><Properties><string name="Name">Screen</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>140.3</X><Y>4.4</Y><Z>0.6</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>0.9659</R11><R12>0.2588</R12><R20>0</R20><R21>-0.2588</R21><R22>0.9659</R22></CoordinateFrame><Vector3 name="size"><X>5</X><Y>2.4</Y><Z>0.2</Z></Vector3><Color3uint8 name="Color3uint8">4278248959</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float>