<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX000720"><Properties><string name="Name">Creator Vault - Tools</string></Properties><Item class="Tool" referent="RBX000707"><Properties><string name="Name">Sword</string></Properties><Item class="Part" referent="RBX000705"><Properties><string name="Name">Handle</string><bool name="Anchored">false</bool><CoordinateFrame name="CFrame"><X>0.5</X><Y>1.4</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>0.8</Y><Z>4</Z></Vector3><Color3uint8 name="Color3uint8">4289782015</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Script" referent="RBX000706"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- SWORD: click to swing. Touch it to pick it up.
local tool = script.Parent
local handle = tool:WaitForChild("Handle")
local DAMAGE = 25
tool.GripPos = Vector3.new(0, 0, -1.5)
tool.GripForward = Vector3.new(-1, 0, 0)
tool.GripRight = Vector3.new(0, 1, 0)
tool.GripUp = Vector3.new(0, 0, 1)
local swinging = false
local hitList = {}
tool.Activated:Connect(function()
	if swinging then
		return
	end
	swinging = true
	hitList = {}
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	task.wait(0.45)
	swinging = false
end)
handle.Touched:Connect(function(hit)
	if not swinging then
		return
	end
	local model = hit.Parent
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if humanoid and model ~= tool.Parent and not hitList[humanoid] then
		hitList[humanoid] = true
		humanoid:TakeDamage(DAMAGE)
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Tool" referent="RBX000710"><Properties><string name="Name">Speed Coil</string></Properties><Item class="Part" referent="RBX000708"><Properties><string name="Name">Handle</string><bool name="Anchored">false</bool><CoordinateFrame name="CFrame"><X>7.8</X><Y>1.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>1</Y><Z>1.6</Z></Vector3><Color3uint8 name="Color3uint8">4280908287</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item><Item class="Script" referent="RBX000709"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- SPEED COIL: hold it to run fast.
local tool = script.Parent
local SPEED = 32
local humanoid = nil
tool.Equipped:Connect(function()
	humanoid = tool.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = SPEED
	end
end)
tool.Unequipped:Connect(function()
	if humanoid then
		humanoid.WalkSpeed = 16
		humanoid = nil
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Tool" referent="RBX000713"><Properties><string name="Name">Gravity Coil</string></Properties><Item class="Part" referent="RBX000711"><Properties><string name="Name">Handle</string><bool name="Anchored">false</bool><CoordinateFrame name="CFrame"><X>15.4</X><Y>1.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1</X><Y>1</Y><Z>1.6</Z></Vector3><Color3uint8 name="Color3uint8">4289956095</Color3uint8><token name="Material">288</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item><Item class="Script" referent="RBX000712"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- GRAVITY COIL: hold it to float like you're on the moon.
local tool = script.Parent
local LIFT = 0.75 -- 0 = normal, 1 = no gravity at all
local force = nil
tool.Equipped:Connect(function()
	local root = tool.Parent:FindFirstChild("HumanoidRootPart")
	if root then
		local attachment = root:FindFirstChild("RootAttachment") or Instance.new("Attachment", root)
		force = Instance.new("VectorForce")
		force.Attachment0 = attachment
		force.RelativeTo = Enum.ActuatorRelativeTo.World
		force.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity * LIFT, 0)
		force.Parent = root
	end
end)
tool.Unequipped:Connect(function()
	if force then
		force:Destroy()
		force = nil
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Tool" referent="RBX000716"><Properties><string name="Name">Healing Potion</string></Properties><Item class="Part" referent="RBX000714"><Properties><string name="Name">Handle</string><bool name="Anchored">false</bool><CoordinateFrame name="CFrame"><X>22.65</X><Y>1.7</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.9</X><Y>1.4</Y><Z>0.9</Z></Vector3><Color3uint8 name="Color3uint8">4294918273</Color3uint8><token name="Material">1568</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Script" referent="RBX000715"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- HEALING POTION: click to drink. Heals you fully.
local tool = script.Parent
tool.Activated:Connect(function()
	local humanoid = tool.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = humanoid.MaxHealth
		tool:Destroy()
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Tool" referent="RBX000719"><Properties><string name="Name">Flashlight</string></Properties><Item class="Part" referent="RBX000717"><Properties><string name="Name">Handle</string><bool name="Anchored">false</bool><CoordinateFrame name="CFrame"><X>29.4</X><Y>1.3</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.6</X><Y>0.6</Y><Z>2</Z></Vector3><Color3uint8 name="Color3uint8">4282532418</Color3uint8><token name="Material">1088</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Script" referent="RBX000718"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- FLASHLIGHT: click to turn on and off.
local tool = script.Parent
local handle = tool:WaitForChild("Handle")
tool.GripForward = Vector3.new(0, 0, -1)
local light = Instance.new("SpotLight")
light.Range = 40
light.Angle = 50
light.Brightness = 4
light.Face = Enum.NormalId.Front
light.Enabled = false
light.Parent = handle
tool.Activated:Connect(function()
	light.Enabled = not light.Enabled
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>