local HEAL = 50
local heart = script.Parent
local ready = true
heart.Touched:Connect(function(hit)
	local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid and ready and humanoid.Health < humanoid.MaxHealth then
		ready = false
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + HEAL)
		heart.Transparency = 1
		task.wait(10)
		heart.Transparency = 0
		ready = true
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000499"><Properties><string name="Name">HeartR</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>34.2</X><Y>3.2</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.6</X><Y>1.6</Y><Z>1.6</Z></Vector3><Color3uint8 name="Color3uint8">4294921581</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">0</token></Properties></Item><Item class="Part" referent="RBX000500"><Properties><string name="Name">HeartTip</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>33.7</X><Y>2.5</Y><Z>0</Z><R00>0.7071</R00><R01>-0.7071</R01><R02>0</R02><R10>0.7071</R10><R11>0.7071</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.5</X><Y>1.5</Y><Z>1.2</Z></Vector3><Color3uint8 name="Color3uint8">4294921581</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item><Item class="Model" referent="RBX000505"><Properties><string name="Name">Power Star</string></Properties><Item class="Part" referent="RBX000503"><Properties><string name="Name">Star</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>42.2</X><Y>3</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>2.4</X><Y>2.4</Y><Z>0.6</Z></Vector3><Color3uint8 name="Color3uint8">4294960640</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</