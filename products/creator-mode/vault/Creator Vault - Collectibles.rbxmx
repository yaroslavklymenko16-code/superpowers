-- TROPHY: grab it for a Trophy point (once per life).
local Players = game:GetService("Players")
local trophy = script.Parent
local got = {}
trophy.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	local character = hit.Parent
	if player and not got[character] then
		got[character] = true
		stat(player, "Trophies").Value += 1
		local fx = Instance.new("Sparkles")
		fx.Parent = trophy
		game:GetService("Debris"):AddItem(fx, 3)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000520"><Properties><string name="Name">Treasure Chest</string></Properties><Item class="Part" referent="RBX000516"><Properties><string name="Name">Box</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>66.6</X><Y>1</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>4</X><Y>2</Y><Z>2.6</Z></Vector3><Color3uint8 name="Color3uint8">4287455034</Color3uint8><token name="Material">528</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item><Item class="Part" referent="RBX000518"><Properties><string name="Name">Lid</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>66.6</X><Y>2.45</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>4</X><Y>0.9</Y><Z>2.6</Z></Vector3><Color3uint8 name="Color3uint8">4288770122</Color3uint8><token name="Material">528</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000517"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[local function stat(player, name)
