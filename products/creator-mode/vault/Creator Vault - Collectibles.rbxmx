<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX000521"><Properties><string name="Name">Creator Vault - Collectibles</string></Properties><Item class="Model" referent="RBX000486"><Properties><string name="Name">Coin</string></Properties><Item class="Part" referent="RBX000485"><Properties><string name="Name">Coin</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>1.5</X><Y>3</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>3</Y><Z>3</Z></Vector3><Color3uint8 name="Color3uint8">4294954280</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties><Item class="Script" referent="RBX000484"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[local function stat(player, name)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local value = stats:FindFirstChild(name)
	if not value then
		value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	return value
end

-- COLLECTIBLE: spins, gives 1 Coins, comes back after 8 seconds.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local VALUE = 1
local RESPAWN = 8
local item = script.Parent
local home = item.CFrame
local angle = 0
local ready = true
RunService.Heartbeat:Connect(function(dt)
	angle += dt * 2
	item.CFrame = home * CFrame.Angles(0, angle, 0)
end)
item.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if player and ready then
		ready = false
		stat(player, "Coins").Value += VALUE
		item.Transparency = 1
		task.wait(RESPAWN)
		item.Transparency = 0
		ready = true
	end
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Model" referent="RBX000489"><Properties><string name="Name">Blue Gem</string></Properties><Item class="Part" referent="RBX000488"><Properties><string name="Name">Gem</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>9.8</X><Y>3</Y><Z>0</Z><R00>0.7071</R00><R01>-0.7071</R01><R02>0</R02><R10>0.5</R10><R11>0.5</R11><R12>-0.7071</R12><R20>0.5</R20><R21>0.5</R21><R22>0.7071</R22></CoordinateFrame><Vector3 name="size"><X>1.6</X><Y>1.6</Y><Z>1.6</Z></Vector3><Color3uint8 name="Color3uint8">4280923894</Color3uint8><token name="Material">1568</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000487"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[local function stat(player, name)
