local star = script.Parent
local ready = true
star.Touched:Connect(function(hit)
	local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid and ready then
		ready = false
		star.Transparency = 1
		humanoid.WalkSpeed = 36
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 90
		task.wait(8)
		humanoid.WalkSpeed = 16
		humanoid.JumpPower = 50
		task.wait(7)
		star.Transparency = 0
		ready = true
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000504"><Properties><string name="Name">StarB</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>42.2</X><Y>3</Y><Z>0</Z><R00>0.7071</R00><R01>-0.7071</R01><R02>0</R02><R10>0.7071</R10><R11>0.7071</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>2.4</X><Y>2.4</Y><Z>0.6</Z></Vector3><Color3uint8 name="Color3uint8">4294960640</Color3uint8><token name="Material">288</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item><Item class="Model" referent="RBX000510"><Properties><string name="Name">Key</string></Properties><Item class="Part" referent="RBX000507"><Properties><string name="Name">Key</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>50</X><Y>3</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>2.4</Y><Z>0.4</Z></Vector3><Color3uint8 name="Color3uint8">4294947584</Color3uint8><token name="Material">1072</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties><Item class="Script" referent="RBX000506"><Properties><string name="Name">Script</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- KEY: pick it up to open any Key Door.
local Players = game:GetService("Players")
local key = script.Parent
local ready = true
key.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if player and ready and not player:GetAttribute("HasKey") then
		ready = false
		player:SetAttribute("HasKey", true)
		key.Transparency = 1
		task.wait(10)
		key.Transparency = 0
		ready = true
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Part" referent="RBX000508"><Properties><string name="Name">Ring</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>50</X><Y>4.4</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>1.2</Y><Z>1.2</Z></Vector3><Color3uint8 name="Color3uint8">4294947584</Color3uint8><token name="Material">1072</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">2</token></Properties></Item><Item class="Part" referent="RBX000509"><Properties><string name="Name">Tooth</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>50</X><Y>2.1</Y><Z>0.4</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.4</X><Y>0.4</Y><Z>0.8</Z></Vector3><Color3uint8 name="Color3uint8">4294947584</Color3uint8><token name="Material">1072</token><bool name="CanCollide">false</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item><Item class="Model" referent="RBX000515"><Properties><string name="Name">Trophy</string></Properties><Item class="Part" referent="RBX000511"><Properties><string name="Name">Base</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>57.6</X><Y>0.4</Y><Z>0</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.8</X><Y>2</Y><Z>2</Z></Vector3><Color3uint8 name="Color3uint8">4284301367</Color3uint8><token name="Material">512</token><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="TopSurface">0